@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: Apache-2.0
+package proxy
+
+import (
+	"net/http/httptest"
+	"testing"
+)
+
+func TestHeteroNoDecodeFallback(t *testing.T) {
+	t.Setenv("HETERO_ENDPOINT_ID", "d")
+	r := httptest.NewRequest("POST", "/v1/completions", nil)
+	r.Header.Set("x-hetero-target", "d")
+	r.Header.Set("x-hetero-path", "pdd")
+	r.Header.Set("x-hetero-expected-host", "127.0.0.1")
+	r.Header.Set("x-hetero-prefill", "p")
+	for _, tc := range []struct {
+		producer string
+		count    int
+		valid    bool
+	}{
+		{"", 0, false}, {"127.0.0.2:8000", 1, false}, {"127.0.0.1:8000", 2, false},
+		{"127.0.0.1:8000", 1, true},
+	} {
+		if ok := validateRoute(r, tc.producer, tc.count) == nil; ok != tc.valid {
+			t.Errorf("producer %v: accepted=%v", tc, ok)
+		}
+	}
+	r.Header.Set("x-hetero-path", "full")
+	if validateRoute(r, "", 0) == nil {
+		t.Fatal("accepted a mixed full/PDD decision")
+	}
+	r.Header.Del("x-hetero-prefill")
+	if err := validateRoute(r, "", 0); err != nil {
+		t.Fatal(err)
+	}
+	r.Header.Set("x-hetero-target", "other")
+	if validateRoute(r, "", 0) == nil {
+		t.Fatal("accepted another endpoint's request")
+	}
+}
+
+func TestHeteroRejectAmbiguousCompletion(t *testing.T) {
+	r := httptest.NewRequest("POST", "/v1/completions", nil)
+	r.Header.Set("x-request-id", "one")
+	for _, body := range []map[string]any{
+		{"prompt": "ok", "n": float64(2)}, {"prompt": []any{"first", "second"}}, {"prompt": []any{}},
+		{"prompt": "ok", "kv_transfer_params": nil}, {"prompt": []any{float64(-1)}},
+	} {
+		if err := validateSingleCompletion(r, body); err == nil {
+			t.Errorf("accepted %v", body)
+		}
+	}
+}
