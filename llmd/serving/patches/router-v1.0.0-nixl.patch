diff --git a/pkg/sidecar/proxy/hetero_nixl.go b/pkg/sidecar/proxy/hetero_nixl.go
new file mode 100644
index 0000000..260e2bf
--- /dev/null
+++ b/pkg/sidecar/proxy/hetero_nixl.go
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: Apache-2.0
+package proxy
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"net"
+	"net/http"
+	"os"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+func strictNIXL() bool { return os.Getenv("HETERO_PDD_STRICT") == "1" }
+
+var internalIDSuffix = regexp.MustCompile("^[0-9a-f]{8}$")
+
+func validateRoute(r *http.Request, prefill string, hosts int) error {
+	h := r.Header
+	if target := h.Get("x-hetero-target"); target == "" || target != os.Getenv("HETERO_ENDPOINT_ID") {
+		return fmt.Errorf("EPP target identity mismatch")
+	}
+	switch h.Get("x-hetero-path") {
+	case "full":
+		if hosts != 0 || h.Get("x-hetero-prefill") != "" || h.Get("x-hetero-preload") != "" {
+			return fmt.Errorf("unexpected PDD controls on full route")
+		}
+	case "pdd":
+		host, port, err := net.SplitHostPort(prefill)
+		if hosts != 1 || err != nil || host == "" || port == "" || host != h.Get("x-hetero-expected-host") || h.Get("x-hetero-prefill") == "" {
+			return fmt.Errorf("missing or inconsistent selected PDD producer")
+		}
+	default:
+		return fmt.Errorf("missing EPP route decision")
+	}
+	return nil
+}
+
+// vLLM 0.22 returns one NIXL lease per completion. Fail before dispatch for
+// representations that would need multiple leases or a different ID scheme.
+func validateSingleCompletion(r *http.Request, body map[string]any) error {
+	if r.URL.Path != "/v1/completions" || r.Header.Get("x-request-id") == "" {
+		return fmt.Errorf("strict NIXL requires /v1/completions and a request ID")
+	}
+	if _, exists := body["kv_transfer_params"]; exists {
+		return fmt.Errorf("client KV transfer controls are reserved")
+	}
+	if n, exists := body["n"]; exists && n != float64(1) {
+		return fmt.Errorf("strict NIXL requires one completion")
+	}
+	if raw, ok := body["prompt"].(json.RawMessage); ok {
+		var prompt any
+		if err := json.Unmarshal(raw, &prompt); err != nil {
+			return err
+		}
+		body["prompt"] = prompt
+	}
+	if raw, ok := body["use_beam_search"].(json.RawMessage); ok && string(raw) == "true" {
+		return fmt.Errorf("strict NIXL requires a single sequence")
+	}
+	switch prompt := body["prompt"].(type) {
+	case string:
+		if prompt != "" {
+			return nil
+		}
+	case []any:
+		if len(prompt) != 0 {
+			for _, id := range prompt {
+				n, ok := id.(float64)
+				if !ok || n < 0 || n != math.Trunc(n) {
+					return fmt.Errorf("expected one tokenized prompt")
+				}
+			}
+			return nil
+		}
+	}
+	return fmt.Errorf("expected one nonempty prompt")
+}
+
+func positiveInt(value any) (int, bool) {
+	number, ok := value.(float64)
+	if !ok || number < 1 || number > math.MaxInt32 || number != math.Trunc(number) {
+		return 0, false
+	}
+	return int(number), true
+}
+
+func validatedHandle(r *http.Request, body, reply map[string]any, status int) (map[string]any, int, error) {
+	h := r.Header
+	id := "cmpl-" + h.Get("x-request-id")
+	params, ok := reply["kv_transfer_params"].(map[string]any)
+	if status != http.StatusOK || !ok || reply["id"] != id || params["do_remote_prefill"] != true || params["do_remote_decode"] != false {
+		return nil, 0, fmt.Errorf("invalid producer response, response ID or transfer direction")
+	}
+	internal, _ := params["remote_request_id"].(string)
+	base := id + "-0"
+	if internal != base && !(strings.HasPrefix(internal, base+"-") && internalIDSuffix.MatchString(strings.TrimPrefix(internal, base+"-"))) {
+		return nil, 0, fmt.Errorf("NIXL lease refers to a different request")
+	}
+	for key, suffix := range map[string]string{"remote_engine_id": "engine", "remote_host": "host"} {
+		expected := h.Get("x-hetero-expected-" + suffix)
+		if expected == "" || params[key] != expected {
+			return nil, 0, fmt.Errorf("unexpected NIXL %s", key)
+		}
+	}
+	for key, suffix := range map[string]string{"remote_port": "port", "tp_size": "tp"} {
+		got, ok := positiveInt(params[key])
+		if !ok || strconv.Itoa(got) != h.Get("x-hetero-expected-"+suffix) {
+			return nil, 0, fmt.Errorf("unexpected NIXL %s", key)
+		}
+	}
+	usage, _ := reply["usage"].(map[string]any)
+	tokens, ok := positiveInt(usage["prompt_tokens"])
+	size, err := strconv.Atoi(h.Get("x-hetero-expected-block-size"))
+	if !ok || err != nil || size <= 0 {
+		return nil, 0, fmt.Errorf("missing prompt or block size")
+	}
+	choices, _ := reply["choices"].([]any)
+	if len(choices) != 1 {
+		return nil, 0, fmt.Errorf("expected a single producer completion")
+	}
+	choice, _ := choices[0].(map[string]any)
+	ids, _ := choice["prompt_token_ids"].([]any)
+	if len(ids) != tokens {
+		return nil, 0, fmt.Errorf("producer prompt token count mismatch")
+	}
+	if original, ok := body["prompt"].([]any); ok && !reflect.DeepEqual(original, ids) {
+		return nil, 0, fmt.Errorf("producer prompt token IDs do not match request")
+	}
+	if covered, exists := params["remote_num_tokens"]; exists && covered != float64(tokens) {
+		return nil, 0, fmt.Errorf("incomplete remote token range")
+	}
+	groups, _ := params["remote_block_ids"].([]any)
+	if len(groups) == 0 {
+		return nil, 0, fmt.Errorf("empty NIXL block group list")
+	}
+	capacity, err := strconv.Atoi(h.Get("x-hetero-expected-num-blocks"))
+	if err != nil || capacity <= 0 {
+		return nil, 0, fmt.Errorf("missing remote block capacity")
+	}
+	expected := (tokens-1)/size + 1
+	total := 0
+	for _, group := range groups {
+		ids, _ := group.([]any)
+		if len(ids) != expected {
+			return nil, 0, fmt.Errorf("incomplete dense-attention block range")
+		}
+		seen := make(map[float64]bool, len(ids))
+		for _, id := range ids {
+			n, ok := id.(float64)
+			if !ok || n < 0 || n >= float64(capacity) || n != math.Trunc(n) || seen[n] {
+				return nil, 0, fmt.Errorf("invalid or duplicated block ID")
+			}
+			seen[n] = true
+		}
+		total += len(ids)
+	}
+	return params, total, nil
+}
